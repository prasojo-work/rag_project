# OpenRouter (embeddings + fallback/deploy chat). Jangan commit file .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat provider: deepseek untuk development, openrouter untuk deploy/demo.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODELS=
DEEPSEEK_THINKING_DISABLED=true

# Chat model OpenRouter (fallback/deploy). Pin satu model, jangan pakai auto-router untuk evaluasi.
# ERNIE paling stabil saat diuji; Gemma 26B sebagai fallback.
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1400

# Judge untuk evaluasi generation.
JUDGE_MODEL=deepseek-v4-pro
JUDGE_FALLBACK_MODELS=deepseek-flash

# Embedding model. Gunakan 8b: model 1b free saat ini gagal untuk batch >1.
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_BATCH_SIZE=16
# Isi hanya jika model mendukung input_type (search_document/search_query).
EMBEDDING_INPUT_TYPE=
EMBEDDING_FAILURE_COOLDOWN_SECONDS=120

# Opsional, untuk identifikasi aplikasi di dashboard OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=TravelKita RAG

# Batas aman aplikasi (dipakai fase API).
MAX_INPUT_CHARS=1000
TOP_K=10
CONTEXT_TOP_K=6
MIN_DENSE_SCORE=0.20
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_BUDGET=100

LLM_MAX_TOKENS=1400
