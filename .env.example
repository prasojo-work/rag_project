# Jangan commit file .env. Salin file ini dulu: cp .env.example .env
#
# Provider chat dan embedding kini generik: nama bebas selama endpoint-nya
# OpenAI-compatible. Ganti provider = edit .env saja, tanpa mengubah kode.

# ----------------------------------------------------------------- Chat provider
# Shorthand "deepseek" dan "openrouter" tetap didukung dan memakai variabel
# DEEPSEEK_* / OPENROUTER_* di bawah. Nama lain dianggap endpoint generik dan
# memakai LLM_BASE_URL + LLM_API_KEY + LLM_MODEL.
#
# Contoh endpoint generik:
#   nvidia     https://integrate.api.nvidia.com/v1
#   groq       https://api.groq.com/openai/v1
#   together   https://api.together.xyz/v1
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODELS=
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1400

# Shorthand deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODELS=
DEEPSEEK_THINKING_DISABLED=true

# Shorthand openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Judge untuk evaluasi generation. Sebaiknya provider berbeda dari generator
# agar tidak ada self-provider bias.
JUDGE_MODEL=deepseek-v4-pro
JUDGE_FALLBACK_MODELS=deepseek-flash

# ------------------------------------------------------------ Embedding provider
# Nama bebas + EMBEDDING_BASE_URL, atau "openrouter" / "hash".
# Jika provider embedding sama dengan provider chat, LLM_API_KEY dan
# LLM_BASE_URL dipakai ulang sehingga EMBEDDING_API_KEY boleh dikosongkan.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_BATCH_SIZE=16
# Wajib untuk model asimetris (mis. Nemotron di NVIDIA NIM): isi "query".
# Saat membangun ulang index dengan model asimetris, pakai --input-type passage.
EMBEDDING_INPUT_TYPE=
EMBEDDING_FAILURE_COOLDOWN_SECONDS=120

# -------------------------------------------------------------------- App limits
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=TravelKita RAG
MAX_INPUT_CHARS=1000
TOP_K=10
CONTEXT_TOP_K=6
MIN_DENSE_SCORE=0.20
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_BUDGET=100
